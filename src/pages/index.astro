---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content={site.description}
    />

    <meta
      name="author"
      content={site.name}
    />

    <link
      rel="canonical"
      href={site.url}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={`${site.name} | ${site.focus}`}
    />

    <meta
      property="og:description"
      content={site.description}
    />

    <meta
      property="og:url"
      content={site.url}
    />

    <title>
      {site.name} | {site.focus}
    </title>
  </head>

  <body>

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="site-header">

      <div class="container nav-wrap">

        <a
          href="/"
          class="brand"
          aria-label="Mahbubur Rahman home"
        >
          <span class="brand-name">
            Mahbubur Rahman
          </span>

          <span class="brand-role">
            ADVOCATE
          </span>
        </a>

        <nav
          class="main-nav"
          aria-label="Main navigation"
        >
          <a href="#about">About</a>

          <a href="#property">
            Property &amp; Land
          </a>

          <a href="#knowledge">
            Legal Knowledge
          </a>

          <a href="#tools">
            Tools
          </a>

          <a href="#services">
            Services
          </a>

          <a
            href="#consultation"
            class="nav-cta"
          >
            আলোচনা করুন
          </a>
        </nav>

        <button
          class="mobile-menu-toggle"
          type="button"
          aria-label="মেনু খুলুন"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

      </div>

      <div
        class="mobile-menu"
        id="mobile-menu"
      >
        <nav
          class="mobile-menu-nav"
          aria-label="Mobile navigation"
        >
          <a href="#about">
            About
          </a>

          <a href="#property">
            Property &amp; Land
          </a>

          <a href="#knowledge">
            Legal Knowledge
          </a>

          <a href="#tools">
            Tools
          </a>

          <a href="#services">
            Services
          </a>

          <a href="/tools/property-risk-checker/">
            Property Risk Checker
          </a>

          <a
            href="#consultation"
            class="mobile-menu-cta"
          >
            আলোচনা করুন
          </a>
        </nav>
      </div>

    </header>


    <main>

      <!-- =====================================================
           HERO
           ===================================================== -->

      <section class="hero">

        <div class="hero-grid">

          <div class="container hero-content">

            <p class="eyebrow">
              CIVIL · PROPERTY · LAND LAW
            </p>

            <h1>
              সিদ্ধান্ত নেওয়ার আগে
              <span>ঝুঁকিটা বুঝুন।</span>
            </h1>

            <p class="hero-text">
              জমি বা property নিয়ে সিদ্ধান্ত শুধু কাগজ দেখে নেওয়ার
              বিষয় নয়। মালিকানা, document, record, transaction history
              এবং legal risk — সবকিছু বুঝে তারপর সিদ্ধান্ত নেওয়াই
              নিরাপদ পথ।
            </p>

            <div class="hero-actions">

              <a
                href="/tools/property-risk-checker/"
                class="button button-primary"
              >
                Property Risk Check করুন
              </a>

              <a
                href="#knowledge"
                class="button button-secondary"
              >
                Legal Knowledge দেখুন
              </a>

            </div>

            <div class="hero-note">

              <span>
                MAHBUBUR RAHMAN
              </span>

              <span>
                LEGAL CLARITY
              </span>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           POSITIONING
           ===================================================== -->

      <section class="positioning-section">

        <div class="container positioning-grid">

          <div>

            <p class="section-kicker">
              THE POSITIONING
            </p>

            <h2>
              Lawyer খোঁজার আগে
              <span>problem টি বুঝুন।</span>
            </h2>

          </div>

          <div>

            <p class="large-copy">
              Property-related decision-এ সবচেয়ে বড় সমস্যা সবসময়
              information-এর অভাব নয়। অনেক সময় সমস্যা হলো — কোন
              information আগে দেখতে হবে, কোন প্রশ্ন করতে হবে এবং
              কোন gap decision-কে risky করে তুলতে পারে, সেটি পরিষ্কার
              না থাকা।
            </p>

            <p>
              এই platform-এর লক্ষ্য সেই gap কমানো — knowledge,
              checklist, tools এবং structured consultation-এর মাধ্যমে।
            </p>

          </div>

        </div>

      </section>


      <!-- =====================================================
           ABOUT
           ===================================================== -->

      <section
        id="about"
        class="section section-light"
      >

        <div class="container about-grid">

          <div>

            <p class="section-kicker">
              ABOUT MAHBUBUR RAHMAN
            </p>

            <h2>
              Practical
              <span>legal clarity.</span>
            </h2>

            <p class="lead">
              Mahbubur Rahman একজন Advocate, যার professional focus
              Civil Law, Property &amp; Land Law, Land Legal Due
              Diligence, Property Documentation এবং Litigation-এর দিকে।
            </p>

            <p>
              Website-টি শুধু profile দেখানোর জন্য নয়। এটি একটি
              দীর্ঘমেয়াদি knowledge asset — যেখানে property-related
              questions, legal concepts, practical checklists এবং
              future interactive tools এক জায়গায় সংগঠিত হবে।
            </p>

            <a
              href="#consultation"
              class="text-link"
            >
              Consultation সম্পর্কে জানুন →
            </a>

          </div>


          <div class="about-card">

            <div class="about-card-label">
              CORE FOCUS
            </div>

            <div class="focus-list">

              <span>
                Civil Law
              </span>

              <span>
                Property &amp; Land
              </span>

              <span>
                Due Diligence
              </span>

              <span>
                Documentation
              </span>

              <span>
                Litigation
              </span>

              <span>
                Legal Research
              </span>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           PROPERTY & LAND
           ===================================================== -->

      <section
        id="property"
        class="section section-dark"
      >

        <div class="container">

          <div class="section-heading">

            <div>

              <p class="section-kicker gold">
                PROPERTY &amp; LAND
              </p>

              <h2>
                Property decision-এর আগে
                <span>৬টি জায়গা দেখুন।</span>
              </h2>

            </div>

            <p>
              কোনো property transaction-কে শুধু “দলিল আছে কি না”
              দিয়ে দেখা যথেষ্ট নয়। একটি structured review আপনাকে
              relevant information একসাথে দেখতে সাহায্য করতে পারে।
            </p>

          </div>


          <div class="checkpoint-grid">

            {
              checkpointsForDecision.map((item) => (
                <div class="checkpoint-card">

                  <span>
                    {item.number}
                  </span>

                  <h3>
                    {item.title}
                  </h3>

                </div>
              ))
            }

          </div>


          <div class="property-bottom">

            <div>

              <p class="mini-label">
                THE IDEA
              </p>

              <p>
                Information → Structure → Understanding →
                Better Question → Better Decision
              </p>

            </div>

            <a
              href="/tools/property-risk-checker/"
              class="button button-outline"
            >
              Risk Checker শুরু করুন
            </a>

          </div>

        </div>

      </section>


      <!-- =====================================================
           SERVICES
           ===================================================== -->

      <section
        id="services"
        class="section section-light"
      >

        <div class="container">

          <div class="section-heading">

            <div>

              <p class="section-kicker">
                PRACTICE AREAS
              </p>

              <h2>
                Legal problem কে
                <span>গুছিয়ে দেখুন।</span>
              </h2>

            </div>

            <p>
              প্রতিটি বিষয় আলাদা। তাই আগে situation বুঝতে হবে,
              তারপর relevant legal pathway নির্ধারণ করতে হবে।
            </p>

          </div>


          <div class="service-grid">

            {
              practiceAreas.map((service) => (
                <article class="service-card">

                  <span class="service-number">
                    {service.number}
                  </span>

                  <h3>
                    {service.title}
                  </h3>

                  <p>
                    {service.text}
                  </p>

                  <a href="#consultation">
                    বিস্তারিত আলোচনা করুন →
                  </a>

                </article>
              ))
            }

          </div>

        </div>

      </section>


      <!-- =====================================================
           TOOLS
           ===================================================== -->

      <section
        id="tools"
        class="section tools-section"
      >

        <div class="container">

          <div class="section-heading">

            <div>

              <p class="section-kicker gold">
                LEGAL TOOLS
              </p>

              <h2>
                শুধু information নয়।
                <span>Useful tools-ও থাকবে।</span>
              </h2>

            </div>

            <p>
              Property legal ecosystem-এর লক্ষ্য হলো complex
              information-কে মানুষের জন্য আরও structured এবং
              usable করে তোলা।
            </p>

          </div>


          <div class="tools-grid">

            {
              tools.map((tool) => (
                <article class="tool-card">

                  <div class="tool-top">

                    <span>
                      {tool.number}
                    </span>

                    <small>
                      {tool.status}
                    </small>

                  </div>

                  <h3>
                    {tool.title}
                  </h3>

                  <p>
                    {tool.text}
                  </p>

                  <a href={tool.href}>
                    {tool.action}
                  </a>

                </article>
              ))
            }

          </div>

        </div>

      </section>


      <!-- =====================================================
           PROPERTY RISK CHECKER
           ===================================================== -->

      <section
        id="risk-checker"
        class="risk-section"
      >

        <div class="container risk-grid">

          <div class="risk-copy">

            <p class="section-kicker gold">
              PROPERTY RISK CHECKER
            </p>

            <h2>
              Property নিয়ে
              <span>অন্ধভাবে সিদ্ধান্ত নেবেন না।</span>
            </h2>

            <p>
              আপনার basic information দিয়ে শুরু করুন। এই prototype-এর
              লক্ষ্য হলো consultation-এর আগে relevant information
              capture করা এবং পরবর্তী legal checklist flow তৈরি করা।
            </p>


            <div class="risk-points">

              <div>

                <strong>
                  01
                </strong>

                <span>
                  আপনার property situation identify করুন
                </span>

              </div>


              <div>

                <strong>
                  02
                </strong>

                <span>
                  Important information gap খুঁজে বের করুন
                </span>

              </div>


              <div>

                <strong>
                  03
                </strong>

                <span>
                  পরবর্তী প্রশ্নগুলো structured করুন
                </span>

              </div>

            </div>

          </div>


          <div class="risk-form-card">

            <div class="form-heading">

              <span>
                FREE RESOURCE
              </span>

              <h3>
                Property Legal Checklist
              </h3>

              <p>
                আপনার basic information দিন। পরবর্তী ধাপে checklist
                ও consultation flow যুক্ত করা হবে।
              </p>

            </div>


            <form
              class="lead-form"
              id="lead-form"
            >

              <label>

                আপনার নাম

                <input
                  type="text"
                  name="name"
                  id="lead-name"
                  placeholder="নাম লিখুন"
                  autocomplete="name"
                  required
                />

              </label>


              <label>

                মোবাইল নম্বর

                <input
                  type="tel"
                  name="phone"
                  id="lead-phone"
                  placeholder="01XXXXXXXXX"
                  autocomplete="tel"
                  inputmode="tel"
                  required
                />

              </label>


              <label>

                Property type

                <select
                  name="property"
                  id="lead-property"
                  required
                >
                  <option value="">
                    নির্বাচন করুন
                  </option>

                  <option value="land">
                    Land
                  </option>

                  <option value="flat">
                    Flat
                  </option>

                  <option value="house">
