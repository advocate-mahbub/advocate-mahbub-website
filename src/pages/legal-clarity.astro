---
import "../styles/global.css";

const phoneDisplay = "+880 1711-481183";
const phoneHref = "tel:+8801711481183";
const email = "advocate.mahbub.dhaka@gmail.com";

const title = "Legal Clarity | Mahbubur Rahman";
const description =
  "জমি, প্রপার্টি ও দেওয়ানি আইনের বিষয়ে সিদ্ধান্ত নেওয়ার আগে তথ্য, ঝুঁকি ও পরবর্তী পদক্ষেপকে structuredভাবে বুঝে নিন।";
---

<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <link
      rel="canonical"
      href="https://www.mahbuburrahman.bd/legal-clarity/"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://www.mahbuburrahman.bd/legal-clarity/"
    />
  </head>

  <body>
    <div class="lc-page">
      <header class="lc-header">
        <div class="lc-container lc-header-inner">
          <a class="lc-brand" href="/" aria-label="Mahbubur Rahman home">
            <span class="lc-brand-name">Mahbubur Rahman</span>
            <span class="lc-brand-role">ADVOCATE · LEGAL CLARITY</span>
          </a>

          <nav class="lc-nav" aria-label="Legal Clarity navigation">
            <a href="#clarity">কেন Clarity আগে?</a>
            <a href="#focus">Practice Focus</a>
            <a href="#process">কীভাবে কাজ করে</a>
            <a href="#consultation">আলোচনা করুন</a>
          </nav>
        </div>
      </header>

      <main>
        <section class="lc-hero">
          <div class="lc-container lc-hero-grid">
            <div class="lc-hero-copy">
              <p class="lc-kicker">CIVIL · PROPERTY · LAND LAW</p>

              <h1>
                সিদ্ধান্ত নেওয়ার আগে
                <span>ঝুঁকিটা বুঝুন।</span>
              </h1>

              <p class="lc-lead">
                জমি বা প্রপার্টি নিয়ে বড় সিদ্ধান্ত নেওয়ার আগে শুধু একজন
                Lawyer-এর মতামত নয়—আপনার দরকার facts, documents, records এবং
                legal risk-এর একটি পরিষ্কার ছবি।
              </p>

              <div class="lc-actions">
                <a class="lc-btn lc-btn-primary" href="#consultation">
                  আলোচনা করুন
                </a>

                <a
                  class="lc-btn lc-btn-secondary"
                  href="/tools/property-risk-checker/"
                >
                  Property Risk Check
                </a>
              </div>

              <p class="lc-note">
                প্রথম লক্ষ্য: কী জানি, কী জানি না, কোথায় risk আছে—সেটা পরিষ্কার করা।
              </p>
            </div>

            <aside class="lc-hero-card">
              <p class="lc-card-kicker">LEGAL CLARITY</p>

              <h2>Lawyer খোঁজার আগে problem-টা বুঝুন।</h2>

              <p>
                সঠিক প্রশ্ন তৈরি হলে legal discussion অনেক বেশি focused হয়।
                আর focused discussion থেকেই ভালো next step নির্ধারণ করা সহজ হয়।
              </p>

              <div class="lc-principle">
                <span>Information</span>
                <span>→</span>
                <span>Structure</span>
                <span>→</span>
                <span>Understanding</span>
              </div>
            </aside>
          </div>
        </section>

        <section class="lc-section lc-light" id="clarity">
          <div class="lc-container">
            <div class="lc-section-head">
              <p class="lc-kicker lc-kicker-dark">WHY CLARITY FIRST</p>

              <h2>
                একটি property decision-এ সমস্যা সাধারণত শুধু একটি জায়গায় থাকে না।
              </h2>

              <p>
                দলিল ঠিক আছে মনে হতে পারে, কিন্তু ownership chain অসম্পূর্ণ হতে
                পারে। খতিয়ান আছে, কিন্তু mutation বা possession-এর প্রশ্ন থাকতে
                পারে। আবার documents ঠিক থাকলেও dispute বা inheritance context
                বদলে দিতে পারে।
              </p>
            </div>

            <div class="lc-grid-3">
              <article class="lc-info-card">
                <span class="lc-number">01</span>
                <h3>Ownership &amp; Title</h3>
                <p>
                  কার কাছ থেকে title এসেছে, chain কোথায় দাঁড়ায়, এবং কোন
                  document কী প্রমাণ করে—সেটা দেখা।
                </p>
              </article>

              <article class="lc-info-card">
                <span class="lc-number">02</span>
                <h3>Property Due Diligence</h3>
                <p>
                  দলিল, খতিয়ান, দাগ, mutation, tax, possession ও সম্ভাব্য
                  dispute-কে একসঙ্গে দেখা।
                </p>
              </article>

              <article class="lc-info-card">
                <span class="lc-number">03</span>
                <h3>Civil Legal Problem</h3>
                <p>
                  বিরোধ তৈরি হলে forum, remedy, evidence ও procedural next step
                  নিয়ে প্রশ্নগুলো সাজানো।
                </p>
              </article>
            </div>
          </div>
        </section>

        <section class="lc-section lc-dark" id="focus">
          <div class="lc-container">
            <div class="lc-section-head lc-section-head-light">
              <p class="lc-kicker">PRACTICE FOCUS</p>

              <h2>
                যে জায়গাগুলোতে legal clarity সবচেয়ে বেশি দরকার
              </h2>
            </div>

            <div class="lc-grid-4">
              <article class="lc-focus-card">
                <p class="lc-focus-label">01</p>
                <h3>Property &amp; Land</h3>
                <p>
                  জমি, ownership, title, record ও property-related legal issues.
                </p>
              </article>

              <article class="lc-focus-card">
                <p class="lc-focus-label">02</p>
                <h3>Land Legal Due Diligence</h3>
                <p>
                  ক্রয় বা transaction-এর আগে documents, records ও risk structure
                  করা।
                </p>
              </article>

              <article class="lc-focus-card">
                <p class="lc-focus-label">03</p>
                <h3>Civil Litigation</h3>
                <p>
                  দেওয়ানি বিরোধে facts, documents, evidence ও procedural
                  pathway বোঝা।
                </p>
              </article>

              <article class="lc-focus-card">
                <p class="lc-focus-label">04</p>
                <h3>Legal Documentation</h3>
                <p>
                  কোন document কেন প্রয়োজন এবং কোন প্রশ্নের উত্তর সেটি দিতে
                  পারে—তা পরিষ্কার করা।
                </p>
              </article>
            </div>
          </div>
        </section>

        <section class="lc-section lc-light" id="process">
          <div class="lc-container lc-process-grid">
            <div class="lc-section-head">
              <p class="lc-kicker lc-kicker-dark">THE CLARITY PROCESS</p>

              <h2>একটি practical legal discussion কীভাবে শুরু হয়?</h2>

              <p>
                লক্ষ্য শুধু information দেওয়া নয়। লক্ষ্য হলো information-কে
                এমন structure-এ আনা, যাতে আপনি পরের প্রশ্নটি ভালোভাবে করতে পারেন।
              </p>
            </div>

            <div class="lc-process-list">
              <div class="lc-process-item">
                <span>01</span>

                <div>
                  <h3>Question</h3>
                  <p>
                    আপনার আসল problem বা decision কী—সেটা নির্ধারণ করা।
                  </p>
                </div>
              </div>

              <div class="lc-process-item">
                <span>02</span>

                <div>
                  <h3>Information</h3>
                  <p>
                    প্রাসঙ্গিক documents, records, facts ও timeline সংগ্রহ করা।
                  </p>
                </div>
              </div>

              <div class="lc-process-item">
                <span>03</span>

                <div>
                  <h3>Risk</h3>
                  <p>
                    কোথায় uncertainty, gap, dispute বা legal concern আছে—তা
                    চিহ্নিত করা।
                  </p>
                </div>
              </div>

              <div class="lc-process-item">
                <span>04</span>

                <div>
                  <h3>Pathway</h3>
                  <p>
                    পরবর্তী legal step নিয়ে focused discussion করা।
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="lc-section lc-soft">
          <div class="lc-container lc-bridge">
            <div>
              <p class="lc-kicker lc-kicker-dark">
                KNOWLEDGE → TOOL → CONSULTATION
              </p>

              <h2>আগে বুঝুন। তারপর সিদ্ধান্ত নিন।</h2>

              <p>
                Legal Knowledge থেকে বিষয়টি বুঝতে পারেন। Property Risk Checker
                দিয়ে information gap চিহ্নিত করতে পারেন। প্রয়োজন হলে
                consultation-এ structuredভাবে আপনার বিষয়টি আলোচনা করতে পারেন।
              </p>
            </div>

            <div class="lc-bridge-actions">
              <a class="lc-btn lc-btn-dark" href="/legal-knowledge/">
                Legal Knowledge
              </a>

              <a
                class="lc-text-link"
                href="/tools/property-risk-checker/"
              >
                Property Risk Check →
              </a>
            </div>
          </div>
        </section>

        <section class="lc-section lc-consultation" id="consultation">
          <div class="lc-container lc-consultation-inner">
            <div>
              <p class="lc-kicker">CONSULTATION</p>

              <h2>আপনার বিষয়টি আগে পরিষ্কারভাবে আলোচনা করি।</h2>

              <p>
                আপনার কাছে থাকা documents, facts এবং মূল প্রশ্নগুলো নিয়ে
                যোগাযোগ করুন। প্রথম ধাপ হলো বিষয়টি বোঝা—তারপর প্রয়োজনীয় legal
                pathway নিয়ে কথা বলা।
              </p>
            </div>

            <div class="lc-contact">
              <a href={phoneHref}>{phoneDisplay}</a>
              <a href={`mailto:${email}`}>{email}</a>

              <a class="lc-btn lc-btn-primary" href={phoneHref}>
                ফোনে আলোচনা করুন
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="lc-footer">
        <div class="lc-container lc-footer-inner">
          <div>
            <strong>Mahbubur Rahman</strong>
            <span>Advocate · Civil · Property · Land Law</span>
          </div>

          <div>
            <a href="/">মূল ওয়েবসাইট</a>
            <a href="/legal-knowledge/">Legal Knowledge</a>
            <a href="/tools/property-risk-checker/">
              Property Risk Checker
            </a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .lc-page {
    background: var(--cream-50);
    color: var(--text-dark);
    min-height: 100vh;
  }

  .lc-container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .lc-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(5, 10, 18, 0.94);
    border-bottom: 1px solid var(--border-dark);
    backdrop-filter: blur(14px);
  }

  .lc-header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .lc-brand {
    color: var(--text-light);
    text-decoration: none;
    display: grid;
    gap: 2px;
  }

  .lc-brand-name {
    font-family: "Noto Serif Bengali", serif;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .lc-brand-role {
    font: 600 0.62rem/1.2 "Inter", sans-serif;
    letter-spacing: 0.14em;
    color: var(--gold-400);
  }

  .lc-nav {
    display: flex;
    gap: 22px;
    align-items: center;
  }

  .lc-nav a {
    color: var(--text-light-muted);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .lc-nav a:hover {
    color: var(--gold-300);
  }

  .lc-hero {
    background:
      radial-gradient(
        circle at 82% 25%,
        rgba(212, 181, 110, 0.12),
        transparent 34%
      ),
      linear-gradient(135deg, var(--navy-950), var(--navy-850));
    color: var(--text-light);
    padding: 105px 0 110px;
  }

  .lc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: 70px;
    align-items: center;
  }

  .lc-kicker {
    margin: 0 0 16px;
    color: var(--gold-400);
    font: 600 0.76rem/1.2 "Inter", sans-serif;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lc-kicker-dark {
    color: var(--gold-600);
  }

  .lc-hero h1 {
    max-width: 820px;
    margin: 0;
    font-family: "Noto Serif Bengali", serif;
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 600;
  }

  .lc-hero h1 span {
    color: var(--gold-300);
  }

  .lc-lead {
    max-width: 720px;
    margin: 28px 0 0;
    color: var(--text-light-muted);
    font-size: 1.08rem;
    line-height: 1.9;
  }

  .lc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .lc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    transition:
      transform var(--transition),
      background var(--transition),
      color var(--transition);
  }

  .lc-btn:hover {
    transform: translateY(-1px);
  }

  .lc-btn-primary {
    background: var(--gold-500);
    color: var(--navy-950);
  }

  .lc-btn-primary:hover {
    background: var(--gold-300);
  }

  .lc-btn-secondary {
    color: var(--text-light);
    border: 1px solid rgba(244, 241, 232, 0.24);
  }

  .lc-btn-secondary:hover {
    border-color: var(--gold-400);
    color: var(--gold-300);
  }

  .lc-btn-dark {
    background: var(--navy-900);
    color: var(--text-light);
  }

  .lc-note {
    margin: 18px 0 0;
    color: rgba(244, 241, 232, 0.52);
    font-size: 0.88rem;
  }

  .lc-hero-card {
    padding: 34px;
    border: 1px solid rgba(212, 181, 110, 0.22);
    background: rgba(255, 255, 255, 0.035);
    box-shadow: var(--shadow-dark);
  }

  .lc-card-kicker {
    margin: 0 0 18px;
    color: var(--gold-400);
    font: 600 0.72rem/1.2 "Inter", sans-serif;
    letter-spacing: 0.15em;
  }

  .lc-hero-card h2 {
    margin: 0;
    color: var(--text-light);
    font-size: 1.65rem;
    line-height: 1.35;
  }

  .lc-hero-card p {
    color: var(--text-light-muted);
  }

  .lc-principle {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
    color: var(--gold-300);
    font-size: 0.82rem;
  }

  .lc-section {
    padding: 105px 0;
  }

  .lc-light {
    background: var(--cream-50);
  }

  .lc-soft {
    background: var(--cream-100);
  }

  .lc-dark {
    background: var(--navy-900);
    color: var(--text-light);
  }

  .lc-section-head {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .lc-section-head h2,
  .lc-bridge h2,
  .lc-consultation h2 {
    margin: 0;
    font-family: "Noto Serif Bengali", serif;
    font-size: clamp(2rem, 4vw, 3.15rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .lc-section-head > p:last-child,
  .lc-bridge p,
  .lc-consultation p {
    margin-top: 20px;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .lc-section-head-light h2 {
    color: var(--text-light);
  }

  .lc-section-head-light > p:last-child {
    color: var(--text-light-muted);
  }

  .lc-grid-3,
  .lc-grid-4 {
    display: grid;
    gap: 18px;
  }

  .lc-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .lc-grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .lc-info-card {
    min-height: 245px;
    padding: 30px;
    background: #fff;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-soft);
  }

  .lc-number,
  .lc-focus-label {
    display: block;
    margin-bottom: 38px;
    color: var(--gold-600);
    font: 600 0.72rem/1 "Inter", sans-serif;
    letter-spacing: 0.14em;
  }

  .lc-info-card h3,
  .lc-focus-card h3,
  .lc-process-item h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .lc-info-card p,
  .lc-focus-card p,
  .lc-process-item p {
    margin: 12px 0 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .lc-focus-card {
    min-height: 270px;
    padding: 28px;
    border: 1px solid var(--border-dark);
    background: rgba(255, 255, 255, 0.025);
  }

  .lc-focus-card h3 {
    color: var(--text-light);
  }

  .lc-focus-card p:not(.lc-focus-label) {
    color: var(--text-light-muted);
  }

  .lc-focus-label {
    color: var(--gold-400);
  }

  .lc-process-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .lc-process-list {
    border-top: 1px solid var(--border-light);
  }

  .lc-process-item {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-light);
  }

  .lc-process-item > span {
    color: var(--gold-600);
    font: 600 0.76rem/1.4 "Inter", sans-serif;
    letter-spacing: 0.12em;
  }

  .lc-bridge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  .lc-bridge > div:first-child {
    max-width: 760px;
  }

  .lc-bridge-actions {
    min-width: 220px;
    display: grid;
    gap: 18px;
  }

  .lc-text-link {
    color: var(--navy-900);
    font-weight: 600;
    text-decoration: none;
  }

  .lc-consultation {
    background: var(--navy-950);
    color: var(--text-light);
  }

  .lc-consultation-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 70px;
    align-items: center;
  }

  .lc-consultation h2 {
    color: var(--text-light);
  }

  .lc-consultation p {
    max-width: 700px;
    color: var(--text-light-muted);
  }

  .lc-contact {
    min-width: 280px;
    display: grid;
    gap: 13px;
  }

  .lc-contact > a:not(.lc-btn) {
    color: var(--text-light);
    text-decoration: none;
